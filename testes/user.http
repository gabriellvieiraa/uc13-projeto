  "name": "João da Silva",
  "cpf": "11144477735",
  "email": "joao.silva@test.com",
  "password": "senha123",
  "type": "DIRECTOR",
  "status": "ATIVO",
  "birthDate": "1990-03-15T00:00:00.000Z"
}

