###########################################################################
### TESTES DE NORMALIZAÇÃO AUTOMÁTICA DE DADOS
###########################################################################

### TESTE 1: NORMALIZAÇÃO - type em minúsculo "admin" deve vir como "ADMIN"
# @name testNormAdmin
POST http://localhost:3000/user/ HTTP/1.1
Content-Type: application/json

{
  "name": "Teste Normalize Admin",
  "cpf": "11144477735",
  "email": "NormalizADMIN@test.com",
  "password": "senha123",
  "type": "admin",
  "status": "ativo",
  "birthDate": "1990-05-10T00:00:00.000Z"
}

### Verificar que type foi convertido para ADMIN
GET http://localhost:3000/user/{{testNormAdmin.response.body.id}}
Content-Type: application/json

### TESTE 2: NORMALIZAÇÃO - type "Admin" (mixed case) deve vir como "ADMIN"
POST http://localhost:3000/user/ HTTP/1.1
Content-Type: application/json

{
  "name": "Teste Mixed Case",
  "cpf": "00000000191",
  "email": "MixedCASE@test.com",
  "password": "senha456",
  "type": "AdMiN",
  "status": "AtIvO"
}

### TESTE 3: NORMALIZAÇÃO - status "inativo" deve vir como "INATIVO"
POST http://localhost:3000/user/ HTTP/1.1
Content-Type: application/json

{
  "name": "Teste Status Inativo",
  "cpf": "11144477736",
  "email": "inativo@test.com",
  "password": "senha789",
  "type": "DIRECTOR",
  "status": "inativo"
}

### TESTE 4: NORMALIZAÇÃO - email "MAIUSCULO@TEST.COM" deve vir como "maiusculo@test.com"
# @name testEmailNorm
POST http://localhost:3000/user/ HTTP/1.1
Content-Type: application/json

{
  "name": "Email Uppercase",
  "cpf": "22244477735",
  "email": "UPPERCASE@TEST.COM",
  "password": "senha999",
  "type": "admin",
  "status": "ativo"
}

### Verificar que email foi convertido para minúsculo
GET http://localhost:3000/user/{{testEmailNorm.response.body.id}}
Content-Type: application/json

### TESTE 5: NORMALIZAÇÃO - EDIÇÃO com valores em lowercase
# @name testEditNorm
PUT http://localhost:3000/user/{{testNormAdmin.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "type": "DIRECTOR",
  "status": "inativo",
  "email": "NEWEMAIL@TEST.COM"
}

