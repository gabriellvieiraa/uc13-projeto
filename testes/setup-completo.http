###########################################################################
### BLOCO 9: VERIFICAÇÕES FINAIS
###########################################################################

### Listar todos os usuários criados
GET http://localhost:3000/user/
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

### Listar todas as empresas
GET http://localhost:3000/companie
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

### Listar todas as categorias (com cursos inclusos)
GET http://localhost:3000/categorie
Content-Type: application/json

### Listar todos os cursos (com categorias inclusos)
GET http://localhost:3000/course
Content-Type: application/json

### Verificar Categoria Tecnologia e seus cursos
GET http://localhost:3000/categorie/{{catTecnologia.response.body.id}}
Content-Type: application/json

### Verificar Categoria Saúde e seus cursos
GET http://localhost:3000/categorie/{{catSaude.response.body.id}}
Content-Type: application/json

### Verificar Categoria Negócios e seus cursos
GET http://localhost:3000/categorie/{{catNegocios.response.body.id}}
Content-Type: application/json

### Verificar Curso 1 e suas categorias
GET http://localhost:3000/course/{{curso1.response.body.id}}
Content-Type: application/json

### Verificar Empresa 1 e seus cursos
GET http://localhost:3000/companie/{{empresa1.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

