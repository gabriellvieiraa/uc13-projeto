POST http://localhost:3000/course HTTP/1.1
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "name": "DevOps e Arquitetura Cloud",
  "description": "Domine Docker, Kubernetes, CI/CD, AWS, Azure, Infrastructure as Code",
